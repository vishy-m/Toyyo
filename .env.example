# Stable Spectrum (https://app.photon.codes). Project id is public; the secret is not.
# There is no pho_sk_ API key on this product.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
SPECTRUM_WEBHOOK_SECRET=
# Required for inbound account binding. Map each demo persona to their direct Space.
PHOTON_PERSONA_SPACES_JSON='{"maya":"any;-;+15551234567"}'
# Protects the optional POST /api/lease-conversation/scan scheduler endpoint.
CRON_SECRET=
# Protects the local demo approval and mileage endpoints.
LEASE_DEMO_SECRET=
# Toyyo defaults to Gemini. Live replies use Gemma 4 (gemma-4-31b-it).
# That model is capped at 30 RPM, 16K TPM, and 14.4K RPD. AGENT_MODEL overrides the id.
AGENT_PROVIDER=gemini
GEMINI_API_KEY=
# Optional text-only model fallback when Gemini is unavailable or rate limited.
XAI_API_KEY=
XAI_MODEL=grok-4.3
# Optional alternative: AGENT_PROVIDER=anthropic and ANTHROPIC_API_KEY=...
