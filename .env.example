# Stable Spectrum (https://app.photon.codes). Project id is public; the secret is not.
# There is no pho_sk_ API key on this product.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# Leave empty to receive messages over the SDK's streaming connection (works on localhost; no public URL).
# Set it (from webhook registration) to use the signed webhook at /api/photon/webhook instead.
SPECTRUM_WEBHOOK_SECRET=
# Optional override: stream | webhook | off
SPECTRUM_INBOUND=
# Required for inbound account binding. Map each demo persona to their direct Space.
PHOTON_PERSONA_SPACES_JSON='{"maya":"any;-;+15551234567"}'
# Protects the optional POST /api/lease-conversation/scan scheduler endpoint.
CRON_SECRET=
# Protects the local demo approval and mileage endpoints.
LEASE_DEMO_SECRET=
# Copilot model (web chat and iMessage). Leave AGENT_PROVIDER empty to use Grok when XAI_API_KEY is set,
# otherwise Gemini. Grok (xAI) runs the full agent with tool calls; XAI_MODEL or AGENT_MODEL overrides the id.
AGENT_PROVIDER=
XAI_API_KEY=
XAI_MODEL=grok-4.3
# Gemini uses Gemma 4 (gemma-4-31b-it), capped at 30 RPM, 16K TPM, and 14.4K RPD. With AGENT_PROVIDER=gemini
# and an XAI_API_KEY, Grok is a text-only fallback when Gemma fails.
GEMINI_API_KEY=
# Optional alternative: AGENT_PROVIDER=anthropic and ANTHROPIC_API_KEY=...
